OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LAW_OPEN_API_OC=
# Optional legacy alias supported by the local dev server.
LAW_OPEN_API_KEY=
# Registered domain for Law Open API validation. Keep this aligned with open.law.go.kr 신청 정보.
LAW_OPEN_API_REFERER=https://gyo6.kr/
PUBLIC_DATA_API_KEY=

# Optional self-hosted Korean Law MCP gateway. Keep the law API key inside the MCP host.
KOREAN_LAW_MCP_BASE_URL=
KOREAN_LAW_MCP_TOKEN=
KOREAN_LAW_MCP_TIMEOUT_MS=12000
KOREAN_LAW_MCP_RESEARCH_ENABLED=false

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

SCOUT_API_KEY=
NANET_API_KEY=

GOOGLE_SEARCH_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Cloudflare Workers
# After deployment, set public/ai-config.js to the Worker URL or set this value in your hosting config.
CLOUDFLARE_AI_WORKER_URL=
OPENAI_KRW_PER_USD=1500
OPENAI_MONTHLY_WARN_USD=10
OPENAI_MONTHLY_STOP_USD=50
OPENAI_DAILY_CALL_LIMIT=30
OPENAI_COST_PRICING_DATE=2026-05-30
FIREBASE_PROJECT_ID=gyo6-law-info
AUTH_REQUIRED=false
# Set in Cloudflare Worker as a secret or dashboard variable. Comma-separated emails.
OWNER_EMAILS=
ADMIN_EMAILS=

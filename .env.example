OPENAI_API_KEY=
LEGACY_ANALYZE_ENABLED=false
LEGACY_SEARCH_ENABLED=false
ANTHROPIC_API_KEY=

LAW_OPEN_API_OC=
# Optional legacy alias supported by the local dev server.
LAW_OPEN_API_KEY=
# Registered domain for Law Open API validation. Keep this aligned with open.law.go.kr 신청 정보.
LAW_OPEN_API_REFERER=https://gyo6.kr/
PUBLIC_DATA_API_KEY=

# Optional self-hosted Korean Law MCP gateway. Keep the law API key inside the MCP host.
KOREAN_LAW_MCP_BASE_URL=
KOREAN_LAW_MCP_TOKEN=
KOREAN_LAW_MCP_TIMEOUT_MS=12000
KOREAN_LAW_MCP_RESEARCH_ENABLED=false

# Optional local Ollama answer polishing for the free rule engine.
# auto/true tries the local Ollama server; false keeps the rule-engine-only answer.
LOCAL_LLM_ENABLED=auto
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:4b-instruct
LOCAL_LLM_NORMALIZER_ENABLED=auto
LOCAL_LLM_NORMALIZER_MODE=auto
LOCAL_LLM_NORMALIZER_MODEL=qwen3:4b-instruct
LOCAL_LLM_NORMALIZER_TIMEOUT_MS=9000
LOCAL_LLM_NORMALIZER_MIN_CONFIDENCE=0.82
LOCAL_LLM_TIMEOUT_MS=12000
LOCAL_LLM_MAX_OUTPUT_TOKENS=720
LOCAL_LLM_CONTEXT_TOKENS=8192
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_BRIDGE_PORT=8789
LOCAL_LLM_BRIDGE_TOKEN=

# Optional remote bridge from Firebase Functions to this office PC's local Ollama bridge.
# Keep disabled until a private tunnel and a long shared token are configured.
REMOTE_LOCAL_LLM_ENABLED=false
REMOTE_LOCAL_LLM_BASE_URL=
REMOTE_LOCAL_LLM_TOKEN=
REMOTE_LOCAL_LLM_TIMEOUT_MS=24000

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

SCOUT_API_KEY=
NANET_API_KEY=
NANET_API_BASE_URL=http://lnp.nanet.go.kr/openapi/lawpreced
NANET_DISPLAY_LINES=5

GOOGLE_SEARCH_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Cloudflare Workers
# After deployment, set public/ai-config.js to the Worker URL or set this value in your hosting config.
CLOUDFLARE_AI_WORKER_URL=
OPENAI_KRW_PER_USD=1500
OPENAI_MONTHLY_WARN_USD=10
OPENAI_MONTHLY_STOP_USD=20
OPENAI_DAILY_CALL_LIMIT=1000
OPENAI_COST_PRICING_DATE=2026-06-13
# Approved pilot: Kakao user utterances may be sent to OpenAI for question normalization/slot extraction.
# Kakao replies must stay within the short skill timeout, so GPT answer composition is off by default.
# Web policy answers may still use optional answer composition for approved law users inside the shared cost gate.
KAKAO_GPT_NORMALIZER_ENABLED=true
KAKAO_GPT_NORMALIZER_MODE=auto
KAKAO_GPT_NORMALIZER_MIN_CONFIDENCE=0.82
KAKAO_GPT_NORMALIZER_TIMEOUT_MS=1800
KAKAO_NLU_MODEL=gpt-5.4-nano
KAKAO_NLU_FALLBACK_MODEL=gpt-5.4-mini
KAKAO_GPT_ANSWER_ENABLED=false
KAKAO_GPT_ANSWER_MODE=off
KAKAO_GPT_ANSWER_MIN_CONFIDENCE=0.72
KAKAO_GPT_ANSWER_TIMEOUT_MS=900
KAKAO_ANSWER_MODEL=gpt-5.4-nano
KAKAO_ANSWER_FALLBACK_MODEL=gpt-5.4-mini
# Kakao chatbot access is blocked unless the Kakao user key is approved in D1 members
# or listed here for a small pilot. Accepted values: raw Kakao key, kakao:<key>, hash, or KAKAO-XXXXXXXXXX code.
KAKAO_AUTH_REQUIRED=true
KAKAO_APPROVED_USER_KEYS=
# Approved pilot: logged-in web law-info user questions may use the same GPT normalization/slot extraction.
POLICY_GPT_NORMALIZER_ENABLED=true
POLICY_GPT_NORMALIZER_MODE=auto
POLICY_GPT_NORMALIZER_MIN_CONFIDENCE=0.82
POLICY_GPT_ANSWER_ENABLED=true
POLICY_GPT_ANSWER_MODE=auto
POLICY_GPT_ANSWER_MIN_CONFIDENCE=0.72
POLICY_ANSWER_MODEL=gpt-5.4-nano
POLICY_ANSWER_FALLBACK_MODEL=gpt-5.4-mini
FIREBASE_PROJECT_ID=gyo6-law-info
# Comma-separated Firebase Auth project IDs trusted for the shared member/permission gate.
# Add the e-book shelf Firebase project ID here when it is different from gyo6-law-info.
FIREBASE_TRUSTED_PROJECT_IDS=gyo6-law-info,gyo6--ebook
AUTH_REQUIRED=true
# Set in Cloudflare Worker as a secret or dashboard variable. Comma-separated emails.
OWNER_EMAILS=
ADMIN_EMAILS=
